# ==========================================
# JobLens Environment Configuration
# ==========================================

# Adzuna API Credentials (Optional for mock/seed mode)
# Register at: https://developer.adzuna.com/
ADZUNA_APP_ID=your_app_id_here
ADZUNA_APP_KEY=your_app_key_here

# Database Configuration
# Option A: SQLite (Default for zero-config local development)
DATABASE_URL=sqlite:///./joblens.db

# Option B: PostgreSQL (Recommended for production with PostGIS)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/job_map

# Alternatively, individual PostgreSQL parameters:
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=job_map

# Backend API URL (Used by Frontend)
API_BASE_URL=http://127.0.0.1:8000
